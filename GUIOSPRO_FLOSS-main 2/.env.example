# Copia este fichero a .env y ajusta lo que necesites.
# Sin .env el sistema arranca igual: docker-compose.yml trae estos mismos valores
# por defecto. Nunca subas tu .env al repositorio.

# ── Base de datos ──
DB_NAME=guiosad
DB_USER=guiosad
DB_PASSWORD=guiosad

# ── Django ──
# En un despliegue real: DEBUG=False, una SECRET_KEY propia y ALLOWED_HOSTS acotado.
DEBUG=False
SECRET_KEY=clave-de-desarrollo-cambiar-en-produccion
ALLOWED_HOSTS=*

# ── Asistente con inteligencia artificial (opcional) ──
# Sin clave el sistema funciona igual: la interfaz oculta el asistente y el
# diagnostico del resultado, la sensibilidad y el plan siguen calculandose.
# Se obtiene en https://console.anthropic.com/
ANTHROPIC_API_KEY=
IA_HABILITADA=True

# ── Evaluar con plantilla (Excel) ──
# False oculta la página «Evaluar con plantilla» y desactiva sus rutas.
# Las evaluaciones ya importadas se conservan y se siguen viendo en el historial.
PLANTILLA_HABILITADA=True

# ── OpenAI / ChatGPT ──
# Clave en https://platform.openai.com/api-keys (requiere saldo de API en
# https://platform.openai.com/settings/organization/billing; ChatGPT Plus/Pro no la incluye).
# IA_PROVEEDOR=anthropic usa esta clave para el asistente; LIT_PROVEEDOR_IA=openai, para la literatura.
IA_PROVEEDOR=anthropic
OPENAI_API_KEY=
OPENAI_MODELO=gpt-5-mini

# ── Importancia de la literatura (innovación CP2) ──
# OpenAlex y Crossref son gratuitos: basta un correo válido para la política de
# "mailto" de ambas APIs. Scopus/WoS requieren clave institucional.
LIT_OPENALEX_MAILTO=
# Gratis en https://openalex.org/settings/api. Sin clave, OpenAlex solo entrega la primera página.
OPENALEX_API_KEY=
SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=
# Vacío = vista BASIC (la que funciona sin entitlements). STANDARD/COMPLETE requieren permisos extra.
SCOPUS_VIEW=
# Opcional: sobrescribe la consulta por defecto (la fecha se añade sola).
SCOPUS_QUERY=
# Proveedor de clasificación: anthropic | groq | openai | demo
# LIT_CLASIFICADOR se conserva por compatibilidad; LIT_PROVEEDOR_IA manda si ambos existen.
LIT_PROVEEDOR_IA=anthropic
LIT_CLASIFICADOR=anthropic
GROQ_API_KEY=
# Fallback: 16 keys de organizaciones Groq distintas, separadas por comas, en el orden
# en que deben usarse. Cuando una agota su cupo diario se pasa a la siguiente.
# GROQ_API_KEY se usa como primera key si esta lista queda vacía. No pegar claves reales aquí.
GROQ_API_KEYS=
LIT_GROQ_SEED=42
# Límites y reintentos de Groq. El código espera a no superar el TPM con margen
# y reintenta los 429 leyendo el tiempo que indica la API. Claude no usa estas variables.
LIT_GROQ_TPM=8000
LIT_GROQ_TPM_MARGEN=0.85
LIT_GROQ_REINTENTOS=5
LIT_GROQ_RESUMEN_MAX=1800
# Vacío = se elige el modelo por defecto del proveedor:
#   anthropic -> claude-opus-5-5
#   groq      -> openai/gpt-oss-120b
#   openai    -> OPENAI_MODELO (gpt-5-mini)
#   demo      -> demo-determinista
LIT_MODELO=
# menciones = citas por subfactor (interpretación de la tesis; por defecto).
# unicos = artículos únicos por factor (solo análisis de sensibilidad).
LIT_METODO_TC=menciones
LIT_MAX_PAGINAS=10
# 0 = todos los artículos. Un valor >0 acorta la corrida para pruebas rápidas.
LIT_MAX_ARTICULOS=0
