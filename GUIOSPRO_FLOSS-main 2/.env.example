# Copia este fichero a .env y ajusta lo que necesites.
# Sin .env el sistema arranca igual: docker-compose.yml trae estos mismos valores
# por defecto. Nunca subas tu .env al repositorio.

# ── Base de datos ──
DB_NAME=guiosad
DB_USER=guiosad
DB_PASSWORD=guiosad

# ── Django ──
# En un despliegue real: DEBUG=False, una SECRET_KEY propia y ALLOWED_HOSTS acotado.
DEBUG=False
SECRET_KEY=clave-de-desarrollo-cambiar-en-produccion
ALLOWED_HOSTS=*

# ── Asistente con inteligencia artificial (opcional) ──
# Sin clave el sistema funciona igual: la interfaz oculta el asistente y el
# diagnostico del resultado, la sensibilidad y el plan siguen calculandose.
# Se obtiene en https://console.anthropic.com/
ANTHROPIC_API_KEY=
IA_HABILITADA=True
